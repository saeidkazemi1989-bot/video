{
  "name": "reelforge",
  "version": "1.3.8",
  "description": "ReelForge — از عکس و ویدیوهایت، خودکار یک ریل حرفه‌ای اینستاگرام بساز (اندروید + iOS)",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node tools/test-core.mjs && node tools/test-features.mjs && node tools/test-ui.mjs && node tools/test-glsl.mjs && node tools/check-music-finite.mjs",
    "test:core": "node tools/test-core.mjs",
    "test:ui": "node tools/test-ui.mjs",
    "test:music": "node tools/check-music-finite.mjs",
    "cap:sync": "npm run build && npx cap sync",
    "android": "npm run cap:sync && npx cap open android",
    "ios": "npm run cap:sync && npx cap open ios",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "icons": "node tools/make-icons.mjs",
    "test:features": "node tools/test-features.mjs",
    "test:glsl": "node tools/test-glsl.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeidkazemi1989-bot/video.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/saeidkazemi1989-bot/video/issues"
  },
  "homepage": "https://github.com/saeidkazemi1989-bot/video#readme",
  "private": "true",
  "type": "module",
  "dependencies": {
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/vazirmatn": "^5.3.0",
    "mp4-muxer": "^5.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "linkedom": "^0.18.13",
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
